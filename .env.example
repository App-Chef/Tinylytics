# Copy to web/.env.local for local development. Never commit real values.

# Supabase project (Settings → API). `npx supabase start` prints local values.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only. Used for event ingestion, the retention job and account deletion.
# Never prefix with NEXT_PUBLIC_ and never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public URL of this deployment (used in the tracking snippet and auth redirects).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Show "Continue with Google" (configure the Google provider in Supabase first).
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false

# Bearer token for GET /api/cron/prune. Generate with: openssl rand -hex 32
CRON_SECRET=

# Days of raw events to keep. Daily totals are kept regardless. Default 395.
DATA_RETENTION_DAYS=395
